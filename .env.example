# ==============================================================================
# DUAL-DATABASE CONFIGURATION (Primary + Secondary Failover & Excess Storage)
# ==============================================================================
# Primary PostgreSQL (Recommended: Neon PostgreSQL)
PRIMARY_DATABASE_URL=postgresql://user:password@ep-primary.neon.tech/neondb?sslmode=require

# Secondary PostgreSQL (Recommended: Supabase PostgreSQL or 2nd Neon DB)
# Used automatically for: (1) Live Mirror & Instant Failover if Primary is down,
# and (2) Excess / Historical Archive Storage when Primary approaches capacity.
SECONDARY_DATABASE_URL=postgresql://postgres:password@db.secondary.supabase.co:5432/postgres?sslmode=require

# Primary capacity threshold in MB before overflow routing warns / archives (default 420 MB for 500 MB free tier)
PRIMARY_MAX_MB=420

# ==============================================================================
# PRODUCTION SECURITY (Signed HttpOnly Session Cookies)
# ==============================================================================
# Owner PIN / Password (Full access: Dashboard, POS, Inventory, Customers, Settings, Dual-DB Admin)
OWNER_PIN=482910

# Optional Staff Counter PIN (POS Billing, Inventory View, Customers — hides Settings & DB Admin)
STAFF_PIN=1234

# Random 32+ character secret used to sign HttpOnly session cookies (HMAC-SHA256)
SESSION_SECRET=change-this-to-a-long-random-64-char-secret-key-in-vercel
